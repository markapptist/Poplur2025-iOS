# Fastfile - Automation for Poplur2025

default_platform(:ios)

platform :ios do
  
  desc "Generate App Store screenshots"
  desc "Usage: fastlane screenshots"
  lane :screenshots do
    # Clear derived data for clean build
    clear_derived_data(derived_data_path: "~/Library/Developer/Xcode/DerivedData")
    
    # Take screenshots using snapshot
    snapshot(
      # Configuration is loaded from Snapfile
      workspace: "Poplur2025.xcworkspace", # or .xcodeproj if no workspace
      scheme: "Poplur2025",
      
      # Devices to generate screenshots for
      devices: [
        "iPhone 15 Pro Max",      # 6.7" display - Required
        "iPhone 15 Pro",          # 6.1" display
        "iPhone SE (3rd generation)", # 4.7" display
        "iPad Pro (12.9-inch) (6th generation)" # iPad Pro 12.9" - Required
      ],
      
      # Languages
      languages: ["en-US"],
      
      # Output
      output_directory: "./fastlane/screenshots",
      
      # Options
      clean: true,
      reinstall_app: true,
      erase_simulator: true,
      stop_after_first_error: false,
      override_status_bar: true,  # Clean status bar
      dark_mode: false,
      
      # Performance
      concurrent_simulators: 4,
      
      # Retry failed screenshots
      number_of_retries: 2
    )
    
    puts "✅ Screenshots generated successfully!"
    puts "📁 Location: ./fastlane/screenshots"
  end
  
  desc "Generate screenshots with device frames"
  desc "Usage: fastlane screenshots_framed"
  lane :screenshots_framed do
    # Generate screenshots first
    screenshots
    
    # Add device frames
    frameit(
      white: false,
      path: "./fastlane/screenshots",
      rose_gold: false
    )
    
    puts "✅ Screenshots framed successfully!"
  end
  
  desc "Upload screenshots to App Store Connect"
  desc "Usage: fastlane upload_screenshots"
  lane :upload_screenshots do
    deliver(
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      screenshots_path: "./fastlane/screenshots",
      submit_for_review: false,
      automatic_release: false
    )
    
    puts "✅ Screenshots uploaded to App Store Connect!"
  end
  
  desc "Full screenshot workflow: generate, frame, and upload"
  desc "Usage: fastlane screenshots_complete"
  lane :screenshots_complete do
    screenshots
    
    # Optionally add frames
    # frameit(white: false, path: "./fastlane/screenshots")
    
    # Upload to App Store Connect
    # upload_screenshots
    
    puts "✅ Screenshot workflow complete!"
  end
  
  # Error handling
  error do |lane, exception|
    puts "❌ Error in lane #{lane}: #{exception.message}"
  end
end
