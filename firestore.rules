rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // The parent post's owner. Posts are written with `userID` by iOS and
    // `userId` by some older paths -- both spellings are already tolerated by
    // the posts rules below, so engagement rules must tolerate them too or a
    // post created through the other path becomes impossible to engage with.
    // postId is passed explicitly rather than picked up from the calling match
    // block. Relying on the ambient path variable evaluated inconsistently --
    // create resolved it while read and delete raised "Null value error" --
    // which is the sort of difference that silently opens a read path.
    function postOwnerOf(postId) {
      let path = /databases/$(database)/documents/posts/$(postId);
      return exists(path)
        ? get(path).data.get('userID', get(path).data.get('userId', ''))
        : '';
    }

    // Play counts belong to the server. A client that could write them could
    // also write itself to the top of every listing.
    function countedTrackFields() {
      return ['playCount', 'reachCount', 'featured'];
    }

    function protectedPremiumAIFields() {
      return [
        'isPremium',
        'premiumTier',
        'aiMonthlyLimit',
        'aiUsedThisMonth',
        'aiUsageMonth'
      ];
    }

    function doesNotWritePremiumAIFields() {
      return !request.resource.data.keys().hasAny(protectedPremiumAIFields());
    }

    function keepsPremiumAIFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedPremiumAIFields());
    }

    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId) && doesNotWritePremiumAIFields();
      allow update: if isSelf(userId) && keepsPremiumAIFieldsUnchanged();
      allow delete: if false;

      match /favorites/{favoriteId} {
        allow read, write: if isSelf(userId);
      }

      match /radiusPurchases/{purchaseId} {
        allow read: if isSelf(userId);
        allow write: if false;
      }

      // The Poplur phone's favourites. Doc id IS the other person's uid, so
      // favouriting twice is idempotent and un-favouriting is a delete of a
      // known path — no query, no duplicates. Yours alone: a favourite says
      // who you intend to call, which is nobody else's business.
      match /phoneFavourites/{contactId} {
        allow read: if isSelf(userId);
        allow write: if isSelf(userId);
      }
    }

    // ── Posted music ─────────────────────────────────────────────────────
    // A track is a POINTER plus the ground it was left on. The audio itself
    // lives in Storage (see storage.rules); this row is what the iPod reads to
    // know a track exists, who made it, and where you have to be to hear it.
    //
    // Readable by anyone, like posts, and for the same reason: music is meant
    // to be found. The radius decides what your reach has EARNED — it is a
    // product rule, not a secrecy boundary, and every pop location is already
    // on the client. Owner-only reads would mean nobody could ever hear
    // anybody else's track, which is the whole product gone.
    match /tracks/{trackId} {
      allow read: if true;

      // Create as YOURSELF, with something actually playable attached. A row
      // naming no source is a track that fails to play with no way to say why,
      // so it is refused here rather than shipped to a client to puzzle over.
      allow create: if signedIn()
        && request.resource.data.userID == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && (
          (request.resource.data.get('audioURL', '') is string
            && request.resource.data.get('audioURL', '').size() > 0)
          || (request.resource.data.get('permalink', '') is string
            && request.resource.data.get('permalink', '').size() > 0)
        )
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        // Set by the server clock, so "newest" cannot be bought with a lie.
        && request.resource.data.createdAt == request.time
        && !request.resource.data.keys().hasAny(countedTrackFields());

      // Editing your own row, but never the counters and never the owner —
      // a track that could change hands could also steal its plays.
      allow update: if signedIn()
        && resource.data.userID == request.auth.uid
        && request.resource.data.userID == resource.data.userID
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(countedTrackFields());

      allow delete: if signedIn() && resource.data.userID == request.auth.uid;
    }

    match /creatorCreditBalances/{userId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    match /creatorCreditTransactions/{transactionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /aiGenerationJobs/{jobId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /generatedAssets/{assetId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /radiusBoostTransactions/{transactionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /aiCampaigns/{campaignId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    // ── Calls (WebRTC signalling) ────────────────────────────────────────
    // A call doc is a rendezvous, not a recording: the offer, the answer and
    // the ICE candidates the two sides need to find each other. Nothing about
    // the media itself passes through here — that goes peer to peer.
    //
    // Readable and writable ONLY by the two people on the call. Signalling is
    // exactly what an attacker would want: an offer plus candidates is enough
    // to attempt a connection to someone's device.
    function callParticipants(callId) {
      let path = /databases/$(database)/documents/calls/$(callId);
      return exists(path) ? get(path).data.participants : [];
    }

    function inCall(callId) {
      return signedIn() && request.auth.uid in callParticipants(callId);
    }

    match /calls/{callId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;

      // Only the caller may open a call, only as themselves, and only to
      // somebody else — a call doc naming two other people would let a third
      // party set up a rendezvous between strangers.
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.callerId == request.auth.uid
        && request.auth.uid in request.resource.data.participants;

      // Either side may answer or hang up, but the roster is fixed.
      allow update: if inCall(callId)
        && request.resource.data.participants == resource.data.participants;
      allow delete: if inCall(callId);

      // ICE candidates, one doc each. Written by the side that gathered them
      // and read by the other; nobody edits a candidate after the fact.
      match /candidates/{candidateId} {
        allow read: if inCall(callId);
        allow create: if inCall(callId)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── Direct messages ──────────────────────────────────────────────────
    // A thread's id is the two uids sorted and joined, so "DM this person" is
    // idempotent — opening a chat twice cannot fork into two threads, and no
    // lookup is needed to find an existing one.
    //
    // `participants` is the whole access boundary. It is fixed at create time
    // and may never change: allowing an update to it would let either side
    // quietly add a third reader to a conversation that already happened.
    function dmParticipants(threadId) {
      let path = /databases/$(database)/documents/dmThreads/$(threadId);
      return exists(path) ? get(path).data.participants : [];
    }

    function inThread(threadId) {
      return signedIn() && request.auth.uid in dmParticipants(threadId);
    }

    match /dmThreads/{threadId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;

      // Exactly two participants, one of them you, and the id must be the
      // canonical pair — otherwise a client could create a thread at an id
      // that a future participant pair would also resolve to.
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && threadId == (request.resource.data.participants[0] < request.resource.data.participants[1]
          ? request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
          : request.resource.data.participants[1] + '_' + request.resource.data.participants[0]);

      // Participants keep the preview fresh, but never the roster.
      allow update: if inThread(threadId)
        && request.resource.data.participants == resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if inThread(threadId);
        // You may only speak as yourself, and only into a thread you are in.
        allow create: if inThread(threadId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        // A sent message is a record of what was said. Editing it after the
        // fact would let either side rewrite the other's history.
        allow update, delete: if false;
      }
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && (request.resource.data.userID == request.auth.uid
          || request.resource.data.userId == request.auth.uid);
      allow update, delete: if signedIn()
        && (resource.data.userID == request.auth.uid
          || resource.data.userId == request.auth.uid);

      // Engagements on a post. Creating one is what causes its owner to be
      // notified, so these rules are the boundary that stops a client paging
      // somebody on someone else's behalf.
      match /engagements/{engagementId} {
        // Readable by the post's owner (their notification history) and by the
        // actor (so a client can tell whether it already liked this post).
        allow read: if signedIn()
          && (request.auth.uid == resource.data.actorUid
            || request.auth.uid == postOwnerOf(postId));

        // An actor may only create engagements AS THEMSELVES, and postOwnerUid
        // must match the real owner of the parent post. postOwnerUid is
        // denormalised so the notification trigger needs no second read, which
        // makes it exactly the field worth forging -- hence checking it against
        // the parent document here rather than trusting the client.
        allow create: if signedIn()
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.postOwnerUid == postOwnerOf(postId)
          && request.resource.data.kind in ['like', 'view', 'comment']
          && request.resource.data.createdAt == request.time;

        // Immutable. Editing an engagement after the fact would let a 'view'
        // become a 'comment' AFTER the trigger decided not to notify for it.
        allow update: if false;

        // Unlikes and deleting your own comment; the owner may remove anything
        // on their own post.
        allow delete: if signedIn()
          && (request.auth.uid == resource.data.actorUid
            || request.auth.uid == postOwnerOf(postId));
      }
    }

    match /delivery_orders/{orderId} {
      allow read: if signedIn()
        && (resource.data.buyerUserId == request.auth.uid
          || resource.data.merchantUserId == request.auth.uid
          || resource.data.postOwnerId == request.auth.uid);
      allow write: if false;
    }

    match /calls/{callId} {
      allow read, write: if signedIn();
    }

    match /businesses/{businessId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUserId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUserId == request.auth.uid;
    }

    // Keep production rules explicit. Add additional collection rules here as new
    // app features are made persistent.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
