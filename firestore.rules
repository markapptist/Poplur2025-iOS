rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/accountDeletions/$(request.auth.uid));
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // ── Blocking ───────────────────────────────────────────────────────────
    //
    // A block lives at users/{blocker}/blocked/{blocked}. The list is private
    // — only its owner may read it — but a RULE may still exists() a document
    // the requesting client cannot read, which is the whole reason this shape
    // works: the boundary is enforceable without telling either party what is
    // on the other's list.
    //
    // Deliberately SYMMETRIC. If A blocks B but A can still write to B, then
    // "block" is a one-way mute that leaves A talking and B unable to answer —
    // a harassment vector wearing a safety label. Either direction closes the
    // channel for both.
    //
    // Keyed on uid, never on a handle: handles are not unique here (one
    // account has published under fourteen of them), so a handle-keyed block
    // would be defeated without the blocked party even trying.
    function hasBlocked(blocker, blocked) {
      return exists(/databases/$(database)/documents/users/$(blocker)/blocked/$(blocked));
    }

    // True when EITHER side has blocked the other.
    function blockedBetween(a, b) {
      return hasBlocked(a, b) || hasBlocked(b, a);
    }

    // The parent post's owner. Posts are written with `userID` by iOS and
    // `userId` by some older paths -- both spellings are already tolerated by
    // the posts rules below, so engagement rules must tolerate them too or a
    // post created through the other path becomes impossible to engage with.
    // postId is passed explicitly rather than picked up from the calling match
    // block. Relying on the ambient path variable evaluated inconsistently --
    // create resolved it while read and delete raised "Null value error" --
    // which is the sort of difference that silently opens a read path.
    function postOwnerOf(postId) {
      let path = /databases/$(database)/documents/posts/$(postId);
      return exists(path)
        ? get(path).data.get('userID', get(path).data.get('userId', ''))
        : '';
    }

    // Play counts belong to the server. A client that could write them could
    // also write itself to the top of every listing.
    function countedTrackFields() {
      return ['playCount', 'reachCount', 'featured'];
    }

    function protectedPremiumAIFields() {
      return [
        'isPremium',
        'premiumTier',
        'aiMonthlyLimit',
        'aiUsedThisMonth',
        'aiUsageMonth'
      ];
    }

    function protectedVerificationFields() {
      return ['verificationTier', 'verificationStatus'];
    }

    // Every aggregate and clock the create rule reads is server-owned
    // (accountTotalRadiusOnPostWritten, recordPostEngagement, radiusDecay).
    // The full post-radius sum is the profile's number; earned − committed is
    // the claim allowance; the post-rate fields are the throttle.
    function serverOwnedAccountRadiusFields() {
      return ['claimRadiusMeters', 'claimRadiusUpdatedAt', 'totalPostRadiusMeters', 'totalPostRadiusUpdatedAt',
        'earnedClaimMeters', 'committedClaimMeters',
        'lastPostAtMillis', 'postWindowStartMillis', 'postsInWindow'];
    }

    function doesNotWritePremiumAIFields() {
      return !request.resource.data.keys().hasAny(protectedPremiumAIFields())
        && !request.resource.data.keys().hasAny(protectedVerificationFields())
        && !request.resource.data.keys().hasAny(serverOwnedAccountRadiusFields());
    }

    function keepsPremiumAIFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedPremiumAIFields())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedVerificationFields())
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOwnedAccountRadiusFields());
    }

    function accountHidesPostOrigin(userId) {
      let path = /databases/$(database)/documents/users/$(userId);
      return exists(path)
        && (get(path).data.get('privateAccount', false) == true
          || get(path).data.get('ghostMode', false) == true);
    }

    function hiddenPostOrigin() {
      return request.resource.data.get('locationVisibility', 'hidden') == 'hidden'
        && !request.resource.data.keys().hasAny([
          'latitude', 'longitude', 'latitudeCell', 'longitudeCell', 'lat', 'lng'
        ]);
    }

    function approximatePostOrigin() {
      return request.resource.data.get('locationVisibility', '') == 'approximate'
        && !request.resource.data.keys().hasAny(['lat', 'lng'])
        && request.resource.data.latitude is number
        && request.resource.data.longitude is number
        && request.resource.data.latitudeCell is int
        && request.resource.data.longitudeCell is int
        && request.resource.data.latitudeCell >= -90000
        && request.resource.data.latitudeCell <= 90000
        && request.resource.data.longitudeCell >= -180000
        && request.resource.data.longitudeCell <= 180000
        && request.resource.data.latitude == request.resource.data.latitudeCell / 1000.0
        && request.resource.data.longitude == request.resource.data.longitudeCell / 1000.0;
    }

    function validPostOrigin(userId) {
      return accountHidesPostOrigin(userId)
        ? hiddenPostOrigin()
        : (hiddenPostOrigin() || approximatePostOrigin());
    }

    // Engagement reach is calculated by recordPostEngagement's authenticated
    // transaction. Owners may still edit captions/media/audience, but no web or
    // native client can forge the counters, radius, boost or notification
    // coalescing state that every realtime surface now trusts.
    function serverOwnedPostEngagementFields() {
      return [
        'radius', 'radiusMeters', 'organicRadiusMeters',
        'seedRadiusMeters',
        'boostedRadiusMeters', 'boostExpiresAt',
        'viewCount', 'likeCount', 'upvoteCount',
        'downvoteCount', 'dislikeCount', 'commentCount', 'shareCount',
        'lastEngagementAt', 'likeNotifyAt', 'likesPendingNotify',
        'decayedAt', 'radiusDecayAnchorMillis', 'radiusDecayOrganicPerDay',
        'radiusDecaySeedPerDay', 'radiusDecayBoostPerDay'
      ];
    }

    function accountMeters(userId, field) {
      let path = /databases/$(database)/documents/users/$(userId);
      let value = exists(path) ? get(path).data.get(field, 0) : 0;
      return value is number && value > 0 ? value : 0;
    }

    // What the account may seed on its next drop: the free 5 km discovery
    // grant plus what it has EARNED (Σ organic over live posts) that is not
    // already COMMITTED on another live pop (Σ seed − 5 km). Both sums are
    // maintained by accountTotalRadiusOnPostWritten; absent means zero, which
    // is the honest answer for an account that has published nothing.
    //
    // Seeds never count toward the claim. From 7 to 17 Sep 2026 the ceiling
    // was the full-radius sum (totalPostRadiusMeters), so every drop could
    // claim the sum of every drop before it: thirteen posts with no engagement
    // reached the world radius. The world radius stays the outer bound.
    function maxSeedRadiusMeters(userId) {
      let earned = accountMeters(userId, 'earnedClaimMeters');
      let committed = accountMeters(userId, 'committedClaimMeters');
      let ceiling = (earned > committed ? earned - committed : 0) + 5000;
      return ceiling > 6371000 ? 6371000 : ceiling;
    }

    // Synthetic actors post at cohort cadence and are exempt from the human
    // post rate only. Auth uids are random, so the prefix cannot collide with
    // a person (functions/src/syntheticIdentity.ts).
    function syntheticActor() {
      return request.auth.uid.matches('(sim|synthetic)-.*');
    }

    // Legacy counters are used only when migrating an account to its first
    // atomic admission. After that, postAdmissions is the authoritative clock.
    function withinPostRate(userId) {
      let path = /databases/$(database)/documents/users/$(userId);
      let last = exists(path) ? get(path).data.get('lastPostAtMillis', 0) : 0;
      let start = exists(path) ? get(path).data.get('postWindowStartMillis', 0) : 0;
      let count = exists(path) ? get(path).data.get('postsInWindow', 0) : 0;
      let now = request.time.toMillis();
      return syntheticActor()
        || ((!(last is number) || now - last >= 60000)
          && (!(start is number) || !(count is number) || now - start >= 86400000 || count < 30));
    }

    // A human post and its account's admission must commit together. Every
    // creation points at a DIFFERENT postId, so a batch cannot attach several
    // posts to one slot. request.time is the server clock, never createdAt or
    // a phone's clock. getAfter is evaluated before the atomic commit.
    function hasPostAdmission(userId, postId) {
      let path = /databases/$(database)/documents/postAdmissions/$(userId);
      let after = getAfter(path).data;
      return after.postId == postId && after.lastPostAt == request.time
        && (!exists(path) || get(path).data.postId != postId);
    }

    function validPostAdmissionShape(userId) {
      let d = request.resource.data;
      let postPath = /databases/$(database)/documents/posts/$(d.postId);
      return d.keys().hasOnly(['postId', 'lastPostAt', 'windowStartedAt', 'postsInWindow'])
        && d.postId is string && d.postId.size() > 0 && d.postId.size() <= 128
        && d.lastPostAt == request.time && d.windowStartedAt is timestamp
        && d.postsInWindow is int && d.postsInWindow > 0 && d.postsInWindow <= 30
        && !exists(postPath)
        && getAfter(postPath).data.get('userID', getAfter(postPath).data.get('userId', '')) == userId;
    }

    function validFirstPostAdmission(userId) {
      let path = /databases/$(database)/documents/users/$(userId);
      let account = exists(path) ? get(path).data : {};
      let start = account.get('postWindowStartMillis', 0);
      let count = account.get('postsInWindow', 0);
      let active = start is number && count is number && start > 0
        && request.time.toMillis() - start < 86400000;
      let d = request.resource.data;
      return withinPostRate(userId)
        && (active
          ? (d.windowStartedAt.toMillis() == start && d.postsInWindow == (count > 0 ? count : 0) + 1)
          : (d.windowStartedAt == request.time && d.postsInWindow == 1));
    }

    function validNextPostAdmission() {
      let before = resource.data;
      let d = request.resource.data;
      let active = request.time - before.windowStartedAt < duration.value(24, 'h');
      return request.time - before.lastPostAt >= duration.value(60, 's')
        && d.postId != before.postId
        && (active
          ? (d.windowStartedAt == before.windowStartedAt && d.postsInWindow == before.postsInWindow + 1)
          : (d.windowStartedAt == request.time && d.postsInWindow == 1));
    }

    // A new post may claim up to the account's full current post-radius sum
    // (at least the 5 km discovery seed, at most the world radius). Initial
    // reach is recorded as seedRadiusMeters; engagement counters and earned
    // radius start at zero, and clients cannot set server-owned decay/boosts.
    function validNewPostEngagementSeed(userId) {
      let d = request.resource.data;
      let ceiling = maxSeedRadiusMeters(userId);
      return d.get('radius', 0) >= 0 && d.get('radius', 0) <= ceiling
        && d.get('radiusMeters', 0) >= 0 && d.get('radiusMeters', 0) <= ceiling
        && d.get('seedRadiusMeters', 0) >= 0 && d.get('seedRadiusMeters', 0) <= ceiling
        && d.get('seedRadiusMeters', 0) <= d.get('radius', 0)
        && d.get('organicRadiusMeters', 0) == 0
        && d.get('viewCount', 0) == 0 && d.get('likeCount', 0) == 0
        && d.get('upvoteCount', 0) == 0 && d.get('downvoteCount', 0) == 0
        && d.get('dislikeCount', 0) == 0 && d.get('commentCount', 0) == 0
        && d.get('shareCount', 0) == 0
        && !d.keys().hasAny(['boostedRadiusMeters', 'boostExpiresAt',
          'lastEngagementAt', 'likeNotifyAt', 'likesPendingNotify', 'decayedAt',
          'radiusDecayAnchorMillis', 'radiusDecayOrganicPerDay',
          'radiusDecaySeedPerDay', 'radiusDecayBoostPerDay']);
    }

    function keepsPostEngagementFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(serverOwnedPostEngagementFields());
    }

    // ── Reports ────────────────────────────────────────────────────────────
    //
    // A report is a signed-in account's write-once note to Poplur about
    // another account, from the visited profile's Block / Report dialog.
    // Nothing reads it back but safety tooling on the admin SDK: the reported
    // party must never learn who reported them, and the reporter has no list
    // to revisit. Bounded fields, so a client cannot use it as free storage.
    match /reports/{reportId} {
      allow read, update, delete: if false;
      allow create: if signedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.userId is string
        && request.resource.data.userId != request.auth.uid
        && request.resource.data.userId.size() <= 128
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 64
        && request.resource.data.keys().hasOnly(
          ['reporterId', 'userId', 'username', 'reason', 'source', 'platform', 'createdAt']);
    }

    match /users/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId) && doesNotWritePremiumAIFields();
      allow update: if isSelf(userId) && keepsPremiumAIFieldsUnchanged();
      allow delete: if false;

      match /favorites/{favoriteId} {
        allow read, write: if isSelf(userId);
      }

      // Your block list is yours alone to read. The blocked party must never
      // be able to enumerate it — learning you blocked them is a consequence
      // of their send failing, not something the database volunteers.
      match /blocked/{blockedUserId} {
        allow read: if isSelf(userId);
        allow create: if isSelf(userId) && userId != blockedUserId;
        allow delete: if isSelf(userId);
        // A block is created or removed, never edited into something else.
        allow update: if false;
      }

      match /radiusPurchases/{purchaseId} {
        allow read: if isSelf(userId);
        allow write: if false;
      }

      // The Poplur phone's favourites. Doc id IS the other person's uid, so
      // favouriting twice is idempotent and un-favouriting is a delete of a
      // known path — no query, no duplicates. Yours alone: a favourite says
      // who you intend to call, which is nobody else's business.
      match /phoneFavourites/{contactId} {
        allow read: if isSelf(userId);
        allow write: if isSelf(userId);
      }

      // Durable notification inbox. Cloud Functions create rows from trusted
      // engagement/DM events; the owner may only acknowledge or dismiss them.
      // Clients cannot invent a row that looks like another person's action,
      // rewrite its target, or delete notification history out from under a
      // second signed-in device.
      match /notifications/{notificationId} {
        allow read: if isSelf(userId);
        allow create, delete: if false;
        allow update: if isSelf(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isUnread', 'readAt', 'isDismissed', 'dismissedAt'
          ])
          && request.resource.data.get('isUnread', false) is bool
          && request.resource.data.get('isDismissed', false) is bool;
      }

      // The exact point selected on the map is account-private. Public post
      // documents carry at most a validated 0.001-degree map cell, while this
      // owner-only record preserves the true target for Poplur mechanics.
      match /postLocations/{postId} {
        allow read, create, update, delete: if isSelf(userId);
      }
    }

    // ── Posted music ─────────────────────────────────────────────────────
    // A track is a POINTER plus the ground it was left on. The audio itself
    // lives in Storage (see storage.rules); this row is what the iPod reads to
    // know a track exists, who made it, and where you have to be to hear it.
    //
    // Readable by anyone, like posts, and for the same reason: music is meant
    // to be found. The radius decides what your reach has EARNED — it is a
    // product rule, not a secrecy boundary, and every pop location is already
    // on the client. Owner-only reads would mean nobody could ever hear
    // anybody else's track, which is the whole product gone.
    match /tracks/{trackId} {
      allow read: if true;

      // Create as YOURSELF, with something actually playable attached. A row
      // naming no source is a track that fails to play with no way to say why,
      // so it is refused here rather than shipped to a client to puzzle over.
      allow create: if signedIn()
        && request.resource.data.userID == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && (
          (request.resource.data.get('audioURL', '') is string
            && request.resource.data.get('audioURL', '').size() > 0)
          || (request.resource.data.get('permalink', '') is string
            && request.resource.data.get('permalink', '').size() > 0)
        )
        && request.resource.data.lat is number
        && request.resource.data.lng is number
        && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
        && request.resource.data.lng >= -180 && request.resource.data.lng <= 180
        // Set by the server clock, so "newest" cannot be bought with a lie.
        && request.resource.data.createdAt == request.time
        && !request.resource.data.keys().hasAny(countedTrackFields());

      // Editing your own row, but never the counters and never the owner —
      // a track that could change hands could also steal its plays.
      allow update: if signedIn()
        && resource.data.userID == request.auth.uid
        && request.resource.data.userID == resource.data.userID
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(countedTrackFields());

      allow delete: if signedIn() && resource.data.userID == request.auth.uid;
    }

    match /creatorCreditBalances/{userId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    match /creatorCreditTransactions/{transactionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /aiGenerationJobs/{jobId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /generatedAssets/{assetId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /radiusBoostTransactions/{transactionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /aiCampaigns/{campaignId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    // ── Calls (WebRTC signalling) ────────────────────────────────────────
    // A call doc is a rendezvous, not a recording: the offer, the answer and
    // the ICE candidates the two sides need to find each other. Nothing about
    // the media itself passes through here — that goes peer to peer.
    //
    // Readable and writable ONLY by the two people on the call. Signalling is
    // exactly what an attacker would want: an offer plus candidates is enough
    // to attempt a connection to someone's device.
    function callParticipants(callId) {
      let path = /databases/$(database)/documents/calls/$(callId);
      return exists(path) ? get(path).data.participants : [];
    }

    function inCall(callId) {
      return signedIn() && request.auth.uid in callParticipants(callId);
    }

    match /calls/{callId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;

      // Only the caller may open a call, only as themselves, and only to
      // somebody else — a call doc naming two other people would let a third
      // party set up a rendezvous between strangers.
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.callerId == request.auth.uid
        && request.auth.uid in request.resource.data.participants
        // A blocked person cannot make your phone ring either.
        && !blockedBetween(request.resource.data.participants[0],
                           request.resource.data.participants[1]);

      // Either side may answer or hang up, but the roster is fixed.
      allow update: if inCall(callId)
        && request.resource.data.participants == resource.data.participants
        && !blockedBetween(resource.data.participants[0], resource.data.participants[1]);
      allow delete: if inCall(callId);

      // ICE candidates, one doc each. Written by the side that gathered them
      // and read by the other; nobody edits a candidate after the fact.
      match /candidates/{candidateId} {
        allow read: if inCall(callId);
        allow create: if inCall(callId)
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── Direct messages ──────────────────────────────────────────────────
    // A thread's id is the two uids sorted and joined, so "DM this person" is
    // idempotent — opening a chat twice cannot fork into two threads, and no
    // lookup is needed to find an existing one.
    //
    // `participants` is the whole access boundary. It is fixed at create time
    // and may never change: allowing an update to it would let either side
    // quietly add a third reader to a conversation that already happened.
    function dmParticipants(threadId) {
      let path = /databases/$(database)/documents/dmThreads/$(threadId);
      return exists(path) ? get(path).data.participants : [];
    }

    function inThread(threadId) {
      return signedIn() && request.auth.uid in dmParticipants(threadId);
    }

    // True when a block stands between the two people on an EXISTING thread.
    // A thread being created has no participants to read yet — that case is
    // gated on the create rule itself, and an atomic first-message batch fails
    // whole if either half is denied.
    function dmBlocked(threadId) {
      return dmParticipants(threadId).size() == 2
        && blockedBetween(dmParticipants(threadId)[0], dmParticipants(threadId)[1]);
    }

    // Atomic first-message batches create the parent thread and its first
    // message together. getAfter() sees the parent as it will exist after that
    // batch, so reliability does not require a visible empty-thread write
    // followed by a second network round trip.
    function inThreadAfter(threadId) {
      let path = /databases/$(database)/documents/dmThreads/$(threadId);
      return signedIn()
        && existsAfter(path)
        && request.auth.uid in getAfter(path).data.participants;
    }

    function validDMMessage() {
      let kind = request.resource.data.get('kind', 'text');
      return request.resource.data.keys().hasOnly([
          'senderId', 'text', 'clientMessageId', 'createdAt',
          'kind', 'mediaURL', 'mimeType', 'durationMillis'
        ])
        && kind in ['text', 'image', 'video', 'audio']
        && (
          kind == 'text'
          || (
            request.resource.data.mediaURL is string
            && request.resource.data.mediaURL.size() <= 2048
            && request.resource.data.mediaURL.matches('https://.*')
            && request.resource.data.mimeType is string
            && request.resource.data.mimeType.matches(kind + '/.*')
            && (kind != 'audio'
              || (request.resource.data.durationMillis is int
                && request.resource.data.durationMillis >= 0
                && request.resource.data.durationMillis <= 60000))
          )
        );
    }

    match /dmThreads/{threadId} {
      // Radius is a discovery/start rule, never a history rule. Once created,
      // this stable two-person participant list keeps the conversation
      // readable even after either account moves outside the other's radius.
      allow read: if signedIn() && request.auth.uid in resource.data.participants;

      // Exactly two participants, one of them you, and the id must be the
      // canonical pair — otherwise a client could create a thread at an id
      // that a future participant pair would also resolve to.
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && request.auth.uid in request.resource.data.participants
        && threadId == (request.resource.data.participants[0] < request.resource.data.participants[1]
          ? request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
          : request.resource.data.participants[1] + '_' + request.resource.data.participants[0])
        // Neither side may open a channel the other has closed.
        && !blockedBetween(request.resource.data.participants[0],
                           request.resource.data.participants[1]);

      // Participants keep the preview fresh, but never the roster.
      allow update: if inThread(threadId)
        && request.resource.data.participants == resource.data.participants
        && !dmBlocked(threadId);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if inThread(threadId);
        // You may only speak as yourself, and only into a thread you are in.
        allow create: if (inThread(threadId) || inThreadAfter(threadId))
          && !dmBlocked(threadId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && request.resource.data.get('clientMessageId', messageId) == messageId
          && validDMMessage();
        // A sent message is a record of what was said. Editing it after the
        // fact would let either side rewrite the other's history.
        allow update, delete: if false;
      }
    }

    // World-readable, server-written summaries (the beta scorecard the landing
    // page and the Test Center both show). Counts and dates only — never a uid.
    match /public/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /postAdmissions/{userId} {
      allow read: if isSelf(userId);
      allow create: if isSelf(userId) && validPostAdmissionShape(userId)
        && validFirstPostAdmission(userId);
      allow update: if isSelf(userId) && validPostAdmissionShape(userId)
        && validNextPostAdmission();
      // Deleting a post or profile must never reset the publishing limit.
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && (request.resource.data.userID == request.auth.uid
          || request.resource.data.userId == request.auth.uid)
        && validNewPostEngagementSeed(request.auth.uid)
        && (syntheticActor() || hasPostAdmission(request.auth.uid, postId))
        && validPostOrigin(request.auth.uid);
      allow update: if signedIn()
        && (resource.data.userID == request.auth.uid
          || resource.data.userId == request.auth.uid)
        && keepsPostEngagementFieldsUnchanged()
        && validPostOrigin(request.auth.uid);
      allow delete: if signedIn()
        && (resource.data.userID == request.auth.uid
          || resource.data.userId == request.auth.uid);

      // Engagements on a post. Creating one is what causes its owner to be
      // notified, so these rules are the boundary that stops a client paging
      // somebody on someone else's behalf.
      match /comments/{commentId} {
        allow read: if true;
        allow write: if false;
      }
      match /engagements/{engagementId} {
        // Readable by the post's owner (their notification history) and by the
        // actor (so a client can tell whether it already liked this post).
        allow read: if signedIn()
          && (request.auth.uid == resource.data.actorUid
            || request.auth.uid == postOwnerOf(postId));

        // Admin-only creation through recordPostEngagement. Direct client
        // writes would bypass the parent-post counter/radius transaction and
        // could attach arbitrary fields (including a comment body) to an event.
        allow create: if false;

        // Immutable. Editing an engagement after the fact would let a 'view'
        // become a 'comment' AFTER the trigger decided not to notify for it.
        allow update: if false;

        // Unlikes and deleting your own comment; the owner may remove anything
        // on their own post.
        allow delete: if signedIn()
          && (request.auth.uid == resource.data.actorUid
            || request.auth.uid == postOwnerOf(postId));
      }

      // The pop's history: one entry per change to its reach, from the first
      // point at creation to now. As public as the post it belongs to (the
      // radius itself is public, and no entry names an actor), and written
      // ONLY by the functions that move a radius — in the same transaction
      // as the move — so the curve can never be edited into a lie.
      match /radiusHistory/{entryId} {
        allow read: if true;
        allow write: if false;
      }
    }

    match /delivery_orders/{orderId} {
      allow read: if signedIn()
        && (resource.data.buyerUserId == request.auth.uid
          || resource.data.merchantUserId == request.auth.uid
          || resource.data.postOwnerId == request.auth.uid);
      allow write: if false;
    }

    match /businesses/{businessId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.ownerUserId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerUserId == request.auth.uid;
    }

    // Keep production rules explicit. Add additional collection rules here as new
    // app features are made persistent.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
