<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications capability, for engagement notifications. `development`
	     covers debug builds signed with a development profile; a distribution
	     build needs `production`, which Xcode substitutes for App Store/TestFlight
	     archives. Without this key the app cannot receive a remote notification
	     at all, even holding a valid token.
	     NOTE: this alone does not make delivery work. An APNs authentication key
	     (.p8) must also be created in the Apple Developer account and uploaded to
	     the Firebase console under Cloud Messaging. Until that is done, tokens
	     register normally and every send fails silently. -->
	<key>aps-environment</key>
	<string>development</string>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(CFBundleIdentifier)</string>
	</array>
</dict>
</plist>
