rules_version = '2';

// Poplur Storage — where posted MUSIC actually lives.
//
// The iPod streams from a URL; this is the bucket that URL points at. Two
// things matter here and nothing else does:
//
//   1. Only the artist may write their own folder. The path carries the uid,
//      so ownership is a path check rather than a document lookup — there is
//      no metadata to forge and no read to pay for.
//   2. Anyone signed in may READ. Music is meant to be found: the radius is a
//      product rule about what your reach has earned, not a secrecy boundary,
//      and every pop location is already on the client. Locking reads to the
//      owner would mean nobody could ever hear anybody else's track, which is
//      the entire product.
//
// The size and content-type checks are the real guard. Without them this
// folder is an unmetered file host that happens to require a login.
service firebase.storage {
  match /b/{bucket}/o {

    // music/{uid}/{trackId}.{ext} — one object per track, named by the same id
    // the Firestore row carries, so a row and its audio can never drift apart.
    match /music/{userId}/{trackId} {
      allow read: if request.auth != null;

      // 25MB is a generous ceiling for a track at streaming bitrates and a
      // hard stop for anything that is not one. contentType is checked on the
      // way IN because it is what the player will trust on the way out.
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('audio/.*');

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Cover art for a track. Small, image-only, same ownership rule.
    match /musicArt/{userId}/{trackId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // profile_selfies/{uid}.{ext} and profile_pictures/{uid}.{ext} — one object
    // per person, named by their uid, which is what makes ownership checkable
    // from the path alone.
    //
    // Without these the catch-all below denied every write, so the app's upload
    // failed silently (it only `print`s) and profilePictureURL /
    // profileSelfieVideoURL never reached Firestore. The visible symptom was a
    // profile that looked fine on the device that set it and was simply absent
    // everywhere else — it had never left that phone.
    //
    // Readable by any signed-in user because an avatar and a profile selfie are
    // shown to the people who find you; that is what they are for. NOT public:
    // this bucket is the app's default one and read access here is a decision
    // about user uploads, not about art.
    match /profile_pictures/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && fileName.split('\\.')[0] == request.auth.uid
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /profile_selfies/{fileName} {
      allow read: if request.auth != null;
      // 40MB: the app exports a ten-second clip, and a short selfie video at
      // phone bitrates lands far under this while a full library video does not.
      allow write: if request.auth != null
        && fileName.split('\\.')[0] == request.auth.uid
        && request.resource.size < 40 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    // posts/{uid}/{fileName} — the media behind a pop: the clip or the photo,
    // plus the poster frame the feed shows while the clip decodes.
    //
    // This was MISSING, and the symptom was the same one the profile comment
    // above describes: every post upload hit the catch-all and was refused with
    // "User does not have permission to access
    // gs://poplur2025.firebasestorage.app/posts/…mp4", so the capture saved
    // locally and never left the phone. Both platforms already name the folder
    // by uid — iOS writes posts/{uid}/{UUID}.mp4 and {UUID}-poster.jpg,
    // Android posts/{uid}/{millis}.mp4 — so ownership is a path check here too,
    // with nothing to forge and no document read to pay for.
    //
    // Reads are open to any signed-in user because a pop is FOR being found;
    // radius is a product rule about reach, not a secrecy boundary, and the
    // same reasoning already governs music above.
    match /posts/{userId}/{fileName} {
      allow read: if request.auth != null;

      // Split by kind rather than one ceiling for both. The clip is exported
      // with AVAssetExportPresetHighestQuality and carries no duration cap, so
      // a legitimate post is genuinely large and a shared limit would either
      // reject real videos or leave images effectively unbounded. contentType
      // is checked on the way IN because it is what the feed trusts on the way
      // out — both platforms set it explicitly (video/mp4, image/jpeg).
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && (
          (request.resource.contentType.matches('video/.*')
            && request.resource.size < 200 * 1024 * 1024)
          || (request.resource.contentType.matches('image/.*')
            && request.resource.size < 12 * 1024 * 1024)
        );

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Private direct-message media. Unlike posts and music, this is not a
    // discoverable surface: only the two participants on the canonical thread
    // may read it. The sender uid remains in the path so writes and cleanup are
    // independently enforceable without trusting object metadata.
    match /dmMedia/{threadId}/{userId}/{fileName} {
      function inThread() {
        return request.auth != null
          && request.auth.uid in firestore.get(
            /databases/(default)/documents/dmThreads/$(threadId)
          ).data.participants;
      }

      allow read: if inThread();
      allow create, update: if inThread()
        && request.auth.uid == userId
        && (
          (request.resource.contentType.matches('image/.*')
            && request.resource.size < 12 * 1024 * 1024)
          || (request.resource.contentType.matches('audio/.*')
            && request.resource.size < 8 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*')
            && request.resource.size < 40 * 1024 * 1024)
        );
      allow delete: if inThread() && request.auth.uid == userId;
    }

    // Nothing else in this bucket is writable from a client.
    //
    // NOTE this does not veto the rules above: Storage rules are a permissive
    // union, so a specific `allow` still grants and this `if false` simply
    // never does. It is the default for paths nothing above claims.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
